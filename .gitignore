# Angular / Node
node_modules/
dist/
.angular/
coverage/
out-tsc/
npm-debug.log*

# GENERATED from content/ by scripts/build-content.mjs on every build (prebuild).
# Deliberately not committed: it is a mechanical projection of content/ and would
# otherwise double the diff of every documentation change with a second, derived copy.
src/assets/content/

# GENERATED by scripts/fetch-releases.mjs during the Pages build, from the GitHub
# Releases API and the GHCR registry. Never hand-edited and never committed: a
# committed copy would be stale the moment the next release is published. The shape
# is src/app/downloads/release-data.ts; examples are src/app/downloads/testing/*.json.
# Locally: `npm run fetch:releases` (needs network), or the page shows "not available".
src/assets/releases.json

# GENERATED by scripts/fetch-board.mjs during the Pages build, from the GitHub project
# board. Never hand-edited and never committed: it changes whenever an issue does, and
# a copy made with a personal token can hold more than the site is allowed to publish.
# The shape is src/app/board/board-data.ts; an example is src/app/board/testing/.
# Locally: `npm run fetch:board` writes "unavailable" unless BOARD_READ_TOKEN is set.
src/assets/board.json

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
